# VoiceMesh Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION
# =============================================================================
ENV=development
DEBUG=True
PORT=8080
LOG_LEVEL=INFO

# =============================================================================
# SPEECH-TO-TEXT (STT)
# =============================================================================
# Deepgram API Key - Get free $200 credit at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# =============================================================================
# TEXT-TO-SPEECH (TTS)
# =============================================================================
# Cartesia API Key - Sign up at https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=professional-female
CARTESIA_MODEL=sonic-english

# =============================================================================
# LARGE LANGUAGE MODEL (LLM)
# =============================================================================
# Anthropic Claude API Key - Get at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# TELEPHONY
# =============================================================================
# SignalWire Credentials - Get at https://signalwire.com
SIGNALWIRE_PROJECT_ID=your_signalwire_project_id
SIGNALWIRE_TOKEN=your_signalwire_token
SIGNALWIRE_SPACE=your_space.signalwire.com

# Twilio Credentials (optional alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL Connection
DATABASE_URL=postgresql://voicemesh:password@localhost:5432/voicemesh
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# CACHE
# =============================================================================
# Redis Connection
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# API Key for customer authentication
API_KEY_SALT=your_api_key_salt_change_this

# =============================================================================
# FILE STORAGE (Tigris - Fly.io S3-compatible)
# =============================================================================
# Tigris Object Storage - Created via `fly storage create`
# These are automatically set by Fly.io when you create a Tigris bucket
AWS_ACCESS_KEY_ID=your_tigris_access_key
AWS_SECRET_ACCESS_KEY=your_tigris_secret_key
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
BUCKET_NAME=voicemesh-recordings

# =============================================================================
# MONITORING & LOGGING (Fly.io Native)
# =============================================================================
# Sentry Error Tracking - Available via Fly.io extension
# Run: fly ext sentry create
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Fly.io Metrics - Built-in Prometheus/Grafana (no config needed)
# Access via: fly dashboard or fly metrics

# =============================================================================
# FLY.IO CONFIGURATION
# =============================================================================
# These are typically set automatically by Fly.io
FLY_APP_NAME=voicemesh
FLY_REGION=iad
FLY_PRIMARY_REGION=iad

# =============================================================================
# CRM INTEGRATIONS
# =============================================================================
# Salesforce
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token

# HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key

# =============================================================================
# MCP SANDBOX CONFIGURATION
# =============================================================================
# Code execution limits
MCP_TIMEOUT_SECONDS=30
MCP_MAX_MEMORY_MB=512
MCP_MAX_CPU_CORES=2
MCP_ENABLE_NETWORK=False

# Allowed Python imports (comma-separated)
MCP_ALLOWED_IMPORTS=requests,json,datetime,re,math

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CALL_RECORDING=True
ENABLE_REAL_TIME_TRANSCRIPTION=True
ENABLE_MCP_CODE_EXECUTION=True
ENABLE_MULTI_LANGUAGE=False

# =============================================================================
# CORS (for web dashboard)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,https://dashboard.voicemesh.com
CORS_ALLOW_CREDENTIALS=True